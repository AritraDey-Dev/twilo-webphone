# ── Server ──
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── App login (single user gate for the phone UI) ──
APP_LOGIN_EMAIL=you@example.com
APP_LOGIN_PASSWORD=change-me

# ── Twilio ──
# Account SID (starts AC...) — Console home.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Key SID (starts SK...) + its Secret — Console → Account → API keys & tokens → Create API key.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
# Auth token — used to validate incoming webhook signatures. Console home.
TWILIO_AUTH_TOKEN=your_auth_token
# TwiML App SID (starts AP...) — Console → Voice → TwiML → TwiML Apps → create one,
# set its Voice URL to  PUBLIC_URL/voice/outgoing  and paste its SID here.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio phone number in E.164 (this is the caller ID for outbound + the number that receives).
TWILIO_NUMBER=+18005550100
# Client identity the browser registers as (any label; inbound calls dial <Client>THIS</Client>).
TWILIO_IDENTITY=webphone

# ── Call recording ──
# Records both directions from the moment the far end answers (dual channel).
# Set to false to disable. Check the consent rules for the places you call.
RECORD_CALLS=true

# ── Webhook signature validation ──
# Leave false for the very first local run; set true once PUBLIC_URL is stable.
VALIDATE_TWILIO=false
# Public HTTPS base that Twilio can reach (your ngrok URL), no trailing slash.
# e.g. https://abcd-1234.ngrok-free.app
PUBLIC_URL=
